# Secrets only. Copy to .env and fill in; .env is gitignored.
#
#   cp .env.example .env
#   cp config.example.toml config.toml
#
# config.toml references these by name, e.g. api_key = "${DEEPSEEK_API_KEY}".
# A name referenced by config.toml but missing here fails loudly at startup
# rather than silently becoming an empty key.

DEEPSEEK_API_KEY=your-deepseek-api-key
EMBEDDING_API_KEY=your-embedding-api-key

# Cloud API durable state. Use a PostgreSQL database; SQLite is test-only.
KIRAKIRA_DATABASE_URL=postgresql://user:password@host:5432/kirakira
KIRAKIRA_SESSION_COOKIE_SECURE=true
KIRAKIRA_SESSION_TTL_SECONDS=1209600
KIRAKIRA_ALLOWED_ORIGINS=https://app.example.com
# KIRAKIRA_AUTH_RATE_LIMIT_PER_MINUTE=10
# KIRAKIRA_MESSAGE_RATE_LIMIT_PER_MINUTE=30
# KIRAKIRA_API_WORKERS=2
# KIRAKIRA_FORWARDED_ALLOW_IPS=127.0.0.1

# Required by the Cloud worker. This must be a separately isolated execution
# service; the Cloud readiness gate rejects host-process execution.
KIRAKIRA_SANDBOX_URL=https://sandbox.internal.example.com
KIRAKIRA_SANDBOX_TOKEN=replace-with-a-long-service-token
# Set these on the isolated sandbox host, not on public API hosts.
# KIRAKIRA_SANDBOX_ROOT=/var/lib/kirakira-sandbox
# KIRAKIRA_SANDBOX_HOST=127.0.0.1
# KIRAKIRA_SANDBOX_PORT=8010
# KIRAKIRA_SANDBOX_MAX_EXECUTIONS=64
# Generate once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
KIRAKIRA_CREDENTIAL_KEY=replace-with-a-generated-fernet-key
# Shared secret used by channel gateway/proxy adapters.
KIRAKIRA_CHANNEL_TOKEN=replace-with-a-long-channel-service-token
# Native channel adapters (enable only the providers you use).
# KIRAKIRA_TELEGRAM_BOT_TOKEN=
# KIRAKIRA_QQ_API_BASE_URL=https://onebot.example.com
# KIRAKIRA_QQ_ACCESS_TOKEN=
# KIRAKIRA_QQBOT_APP_ID=
# KIRAKIRA_QQBOT_CLIENT_SECRET=
# KIRAKIRA_QQBOT_API_BASE_URL=https://api.sgroup.qq.com
# Remote integrations are public HTTPS only; optionally narrow them further.
# KIRAKIRA_MCP_DOMAIN_ALLOWLIST=mcp.example.com,plugins.example.com
# KIRAKIRA_SANDBOX_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Advanced: these override config.toml entirely and are mainly for CI or for
# running without a config.toml at all. Leave them unset for normal use.
# ---------------------------------------------------------------------------
# OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com/v1
# OPENAI_COMPATIBLE_API_KEY=your-deepseek-api-key
# MODEL_ID=deepseek-v4-flash
# Application resource root (built-in Drift skills), not a user's local workspace.
# KIRAKIRA_WORKSPACE=/opt/kirakira/current
